{
	"name": "baby_claw",
	"version": "0.1.0",
	"description": "OpenClaw plugin scaffold for privacy-preserving baby care records.",
	"type": "module",
	"private": true,
	"files": [
		"dist",
		"openclaw.plugin.json",
		"skills"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "biome check --write . && tsc -p tsconfig.json --noEmit",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.41",
		"openclaw": "2026.4.9"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"typescript": "^5.9.3"
	},
	"openclaw": {
		"extensions": [
			"./src/index.ts"
		],
		"runtimeExtensions": [
			"./dist/index.js"
		],
		"compat": {
			"pluginApi": ">=2026.4.9",
			"minGatewayVersion": "2026.4.9"
		},
		"build": {
			"openclawVersion": "2026.4.9",
			"pluginSdkVersion": "2026.4.9"
		}
	}
}
