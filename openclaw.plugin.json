{
	"id": "baby_claw",
	"name": "Baby Claw",
	"description": "Privacy-preserving baby care record tools for OpenClaw.",
	"version": "0.1.0",
	"configSchema": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"suiNetwork": {
				"anyOf": [
					{ "const": "testnet", "type": "string" },
					{ "const": "devnet", "type": "string" },
					{ "const": "localnet", "type": "string" }
				]
			},
			"suiPrivateKey": { "type": "string" },
			"walrusPublisherUrl": {
				"anyOf": [
					{ "format": "uri", "type": "string" },
					{ "pattern": "^\\$\\{[A-Z_][A-Z0-9_]*\\}$", "type": "string" }
				]
			},
			"walrusAggregatorUrl": {
				"anyOf": [
					{ "format": "uri", "type": "string" },
					{ "pattern": "^\\$\\{[A-Z_][A-Z0-9_]*\\}$", "type": "string" }
				]
			},
			"stateDir": { "type": "string" },
			"encryptImages": { "type": "boolean" },
			"walrusEpochs": { "minimum": 1, "type": "integer" }
		}
	},
	"uiHints": {
		"suiPrivateKey": {
			"label": "Sui private key",
			"sensitive": true
		}
	},
	"skills": ["skills/baby_claw"],
	"contracts": {
		"tools": [
			"baby_claw_healthcheck",
			"baby_claw_init",
			"baby_claw_status",
			"baby_claw_record_milk",
			"baby_claw_sleep_start",
			"baby_claw_sleep_end",
			"baby_claw_record_poop",
			"baby_claw_get_today",
			"baby_claw_get_last"
		]
	}
}
